# Variables de entorno para desarrollo local.
# Copiar a .env (que NO se sube al repositorio) y cambiar las contraseñas:
#   cp .env.example .env
# Los valores reales de producción nunca se guardan en el repositorio (consigna §2.12).

# --- MySQL (Operaciones y Recursos; una base y un usuario por servicio) ---
MYSQL_ROOT_PASSWORD=cambiar-admin
OPERACIONES_DB_PASSWORD=cambiar-operaciones
RECURSOS_DB_PASSWORD=cambiar-recursos

# --- MongoDB (Identidad, Notificaciones e Integración; un usuario por servicio) ---
MONGO_ADMIN_PASSWORD=cambiar-admin
IDENTIDAD_DB_PASSWORD=cambiar-identidad
NOTIFICACIONES_DB_PASSWORD=cambiar-notificaciones
INTEGRACION_DB_PASSWORD=cambiar-integracion

# --- RabbitMQ ---
RABBITMQ_USER=rumbo
RABBITMQ_PASSWORD=cambiar-rabbit

# --- Firma de tokens (la usa Identidad para firmar y el Gateway para validar) ---
TOKEN_SECRETO=cambiar-por-un-secreto-largo

# --- Identidad: usuario administrador inicial y credenciales del sistema externo (grupo consumidor) ---
ADMIN_EMAIL=admin@rumbo.local
ADMIN_PASSWORD=cambiar-admin-web
EXTERNO_CLIENT_ID=org-almacenamiento
EXTERNO_CLIENT_SECRET=cambiar-secreto-externo
EXTERNO_ORGANIZACION_NOMBRE=Gestión de almacenamiento
# Usuarios de demostración de la web (docs/interfaces-internas.md §15). Vacíos = no se crean.
OPERADOR_EMAIL=operador@rumbo.local
OPERADOR_PASSWORD=cambiar-operador
CLIENTE_EMAIL=cliente@almacenamiento.local
CLIENTE_PASSWORD=cambiar-cliente

# --- Secreto entre el gateway y los servicios (§11.2, ADR-026): sin él, un servicio responde 401 ---
SECRETO_INTERNO=cambiar-secreto-interno

# --- Aplicación web: origen habilitado por CORS en el gateway ---
WEB_ORIGEN=http://localhost:5173

# --- Clima del aeropuerto (D9): clave que nos entrega el grupo proveedor. El mock acepta cualquiera ---
CLIMA_API_KEY=demo
# Sin CLIMA_URL se usa el mock local (clima-mock). Para el proveedor real, descomentar y poner su clave en CLIMA_API_KEY.
# Se duerme sin uso: antes de una demo, despertarlo (ver docs/contracts/consumidos/README.md).
# CLIMA_URL=https://clima-aeropuerto.onrender.com
# Solo desarrollo (ADR-025): con el mock, hace que responda "aeropuerto no operable" para probar la alerta.
# CLIMA_PREFER=example=not_operable

# --- Docker Compose: consumo de memoria ---
# Compila las imágenes de a una (el build de Go es el pico de memoria).
COMPOSE_PARALLEL_LIMIT=1
# Observabilidad (Grafana LGTM, ~1 GB de RAM): descomentar las dos líneas para activarla.
# COMPOSE_PROFILES=observabilidad
# OTEL_EXPORTER_OTLP_ENDPOINT=http://lgtm:4318
# Logs en MySQL (ADR-023): los servicios insertan con rumbo_logs; la contraseña es la de LOGS_DB_PASSWORD.
# LOGS_MYSQL_DSN=rumbo_logs:cambiar-logs@tcp(mysql-logs:3306)/observabilidad

# --- MySQL de logs (solo con el perfil observabilidad) ---
LOGS_DB_PASSWORD=cambiar-logs
GRAFANA_LOGS_DB_PASSWORD=cambiar-grafana-logs
