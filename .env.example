# Variables de entorno para desarrollo local.
# Copiar a .env (que NO se sube al repositorio) y cambiar las contraseñas:
#   cp .env.example .env
# Los valores reales de producción nunca se guardan en el repositorio (consigna §2.12).

# --- MySQL (Operaciones y Recursos; una base y un usuario por servicio) ---
MYSQL_ROOT_PASSWORD=cambiar-admin
OPERACIONES_DB_PASSWORD=cambiar-operaciones
RECURSOS_DB_PASSWORD=cambiar-recursos

# --- MongoDB (Identidad, Notificaciones e Integración; un usuario por servicio) ---
MONGO_ADMIN_PASSWORD=cambiar-admin
IDENTIDAD_DB_PASSWORD=cambiar-identidad
NOTIFICACIONES_DB_PASSWORD=cambiar-notificaciones
INTEGRACION_DB_PASSWORD=cambiar-integracion

# --- RabbitMQ ---
RABBITMQ_USER=rumbo
RABBITMQ_PASSWORD=cambiar-rabbit

# --- Firma de tokens (la usa Identidad para firmar y el Gateway para validar) ---
TOKEN_SECRETO=cambiar-por-un-secreto-largo
