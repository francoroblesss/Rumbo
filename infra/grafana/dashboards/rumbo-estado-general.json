{
  "uid": "rumbo-estado-general",
  "title": "Rumbo — estado general",
  "tags": [
    "rumbo",
    "observabilidad"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "graphTooltip": 1,
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "1. Requests por segundo por servicio",
      "description": "Tasa de pedidos HTTP atendidos por cada servicio (RED: rate).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (job) (rate(rumbo_http_duracion_segundos_seconds_count[5m]))",
          "legendFormat": "{{job}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 8
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "2. Errores 5xx por servicio (%)",
      "description": "Porcentaje de respuestas 5xx sobre el total de cada servicio (RED: errors).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * sum by (job) (rate(rumbo_http_duracion_segundos_seconds_count{estado=~\"5..\"}[5m])) / sum by (job) (rate(rumbo_http_duracion_segundos_seconds_count[5m]))",
          "legendFormat": "{{job}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 8
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "3. Latencia p95 por servicio",
      "description": "Percentil 95 de la duración de los pedidos HTTP de cada servicio (RED: duration).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, job) (rate(rumbo_http_duracion_segundos_seconds_bucket[5m])))",
          "legendFormat": "{{job}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 8
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "4. Requests por instancia de Integración (balanceo)",
      "description": "Evidencia del balanceo de carga (ADR-009): los pedidos tienen que repartirse entre las réplicas.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (instancia) (rate(rumbo_http_duracion_segundos_seconds_count{job=\"integracion\"}[5m]))",
          "legendFormat": "{{instancia}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 8,
        "h": 8
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "5. Hit ratio de las cachés",
      "description": "Proporción de aciertos de la caché de solicitudes y de la de clima (hit / (hit + miss)).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (cache) (rate(rumbo_cache_operaciones_total{resultado=\"hit\"}[5m])) / sum by (cache) (rate(rumbo_cache_operaciones_total{resultado=~\"hit|miss\"}[5m]))",
          "legendFormat": "{{cache}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "gridPos": {
        "x": 8,
        "y": 8,
        "w": 8,
        "h": 8
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "6. Pendientes de outbox por servicio",
      "description": "Eventos guardados que todavía no se publicaron en RabbitMQ. Tiene que volver a 0.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (servicio) (rumbo_outbox_pendientes)",
          "legendFormat": "{{servicio}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "gridPos": {
        "x": 16,
        "y": 8,
        "w": 8,
        "h": 8
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "7. Mensajes procesados por resultado",
      "description": "Mensajes consumidos por resultado: ok, reintento o DLQ (teórico 4).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (resultado) (rate(rumbo_mensajes_procesados_total[5m]))",
          "legendFormat": "{{resultado}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 8,
        "h": 8
      }
    },
    {
      "id": 8,
      "type": "stat",
      "title": "8. Estado de los circuitos",
      "description": "Circuit breaker de cada dependencia (teórico 7): cerrado, semiabierto o abierto.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (dependencia) (rumbo_circuito_estado)",
          "legendFormat": "{{dependencia}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {},
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Cerrado",
                  "color": "green",
                  "index": 0
                },
                "1": {
                  "text": "Semiabierto",
                  "color": "yellow",
                  "index": 1
                },
                "2": {
                  "text": "Abierto",
                  "color": "red",
                  "index": 2
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "none"
      },
      "gridPos": {
        "x": 8,
        "y": 16,
        "w": 8,
        "h": 8
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "9. Consultas de clima por resultado",
      "description": "Consultas al sistema del aeropuerto (D9): operable, no operable o no verificado.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (resultado) (rate(rumbo_clima_consultas_total[5m]))",
          "legendFormat": "{{resultado}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "gridPos": {
        "x": 16,
        "y": 16,
        "w": 8,
        "h": 8
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "10. Rechazos del gateway por motivo",
      "description": "Pedidos que el gateway no dejó pasar: sin autenticar, límite de tráfico o ruta interna.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (motivo) (rate(rumbo_gateway_rechazos_total[5m]))",
          "legendFormat": "{{motivo}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 8,
        "h": 8
      }
    },
    {
      "id": 11,
      "type": "table",
      "title": "11. Errores recientes",
      "description": "Logs de nivel ERROR del período (tabla logs en MySQL, ADR-023). trace_id abre la traza en Tempo; correlation_id filtra todos los logs de esa operación.",
      "datasource": {
        "type": "mysql",
        "uid": "mysql-logs"
      },
      "gridPos": {
        "x": 8,
        "y": 24,
        "w": 16,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "mysql-logs"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT creado_en AS time, servicio, instancia, mensaje, correlation_id, trace_id, atributos\nFROM logs\nWHERE $__timeFilter(creado_en) AND nivel = 'ERROR' AND servicio IN (${servicio:sqlstring})\nORDER BY creado_en DESC, id DESC LIMIT 100"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "trace_id"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Ver la traza en Tempo",
                    "url": "/explore?left={\"datasource\": \"tempo\", \"queries\": [{\"refId\": \"A\", \"datasource\": {\"type\": \"tempo\", \"uid\": \"tempo\"}, \"queryType\": \"traceql\", \"query\": \"${__value.raw}\"}]}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "correlation_id"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Todos los logs de esta operación",
                    "url": "/d/rumbo-estado-general?var-correlation_id=${__value.raw}&${__url_time_range}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "nivel"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "ERROR": {
                        "color": "red",
                        "index": 0
                      },
                      "WARN": {
                        "color": "orange",
                        "index": 1
                      },
                      "INFO": {
                        "color": "text",
                        "index": 2
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "12. Logs por minuto, por nivel",
      "description": "Cuántos logs de cada nivel se escribieron por minuto (MySQL). Un salto de ERROR o WARN es la señal para bajar a la tabla de logs.",
      "datasource": {
        "type": "mysql",
        "uid": "mysql-logs"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "mysql-logs"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT $__timeGroupAlias(creado_en, '1m'), nivel AS metric, COUNT(*) AS value\nFROM logs\nWHERE $__timeFilter(creado_en) AND servicio IN (${servicio:sqlstring})\nGROUP BY 1, nivel ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "ERROR"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "WARN"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "INFO"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "13. Logs descartados (no llegaron a MySQL)",
      "description": "rumbo_logs_descartados_total: logs que no se guardaron porque la cola estaba llena o MySQL falló. Siguen en stdout (docker compose logs).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (job, motivo) (increase(rumbo_logs_descartados_total[5m])) or vector(0)",
          "legendFormat": "{{job}} {{motivo}}"
        }
      ]
    },
    {
      "id": 14,
      "type": "table",
      "title": "14. Logs (filtrar por nivel, servicio y correlation_id)",
      "description": "Todos los logs INFO, WARN y ERROR del período. Para seguir una operación entre servicios, pegar su correlation_id (lo devuelve el gateway en X-Correlation-ID) en la variable de arriba.",
      "datasource": {
        "type": "mysql",
        "uid": "mysql-logs"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 24,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "mysql-logs"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT creado_en AS time, nivel, servicio, instancia, mensaje, correlation_id, trace_id, atributos\nFROM logs\nWHERE $__timeFilter(creado_en) AND nivel IN (${nivel:sqlstring}) AND servicio IN (${servicio:sqlstring}) AND (${correlation_id:sqlstring} = '' OR correlation_id = ${correlation_id:sqlstring})\nORDER BY creado_en DESC, id DESC LIMIT 500"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "trace_id"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Ver la traza en Tempo",
                    "url": "/explore?left={\"datasource\": \"tempo\", \"queries\": [{\"refId\": \"A\", \"datasource\": {\"type\": \"tempo\", \"uid\": \"tempo\"}, \"queryType\": \"traceql\", \"query\": \"${__value.raw}\"}]}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "correlation_id"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Todos los logs de esta operación",
                    "url": "/d/rumbo-estado-general?var-correlation_id=${__value.raw}&${__url_time_range}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "nivel"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "ERROR": {
                        "color": "red",
                        "index": 0
                      },
                      "WARN": {
                        "color": "orange",
                        "index": 1
                      },
                      "INFO": {
                        "color": "text",
                        "index": 2
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    }
  ],
  "templating": {
    "list": [
      {
        "name": "nivel",
        "label": "Nivel",
        "type": "custom",
        "multi": true,
        "includeAll": false,
        "query": "ERROR,WARN,INFO",
        "current": {
          "text": [
            "ERROR",
            "WARN",
            "INFO"
          ],
          "value": [
            "ERROR",
            "WARN",
            "INFO"
          ]
        },
        "options": [
          {
            "text": "ERROR",
            "value": "ERROR",
            "selected": true
          },
          {
            "text": "WARN",
            "value": "WARN",
            "selected": true
          },
          {
            "text": "INFO",
            "value": "INFO",
            "selected": true
          }
        ]
      },
      {
        "name": "servicio",
        "label": "Servicio",
        "type": "query",
        "datasource": {
          "type": "mysql",
          "uid": "mysql-logs"
        },
        "multi": true,
        "includeAll": true,
        "refresh": 2,
        "query": "SELECT DISTINCT servicio FROM logs ORDER BY servicio",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "correlation_id",
        "label": "correlation_id (vacío = todos)",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  }
}
